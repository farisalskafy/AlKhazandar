{
  "name": "alkhazandar-sales",
  "version": "1.0.0",
  "description": "برنامج الخزندار للمبيعات والمخزون باللغة العربية",
  "main": "main.js",
  "author": "Alkhazandar",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.alkhazandar.sales",
    "productName": "الخزندار للمبيعات",
    "directories": { "output": "dist" },
    "files": ["main.js", "index.html", "package.json"],
    "win": { "target": ["nsis"], "artifactName": "Alkhazandar-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
